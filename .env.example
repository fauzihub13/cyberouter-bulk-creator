# cyberouter-bulk-creator configuration
# Copy to `.env`. CLI flags override these. Never commit a real `.env`.

# Receiving domain for zenvex.dev. Only `souss.dev` is verified for delivery.
CYBEROUTER_DOMAIN=souss.dev

# Max ms to wait for the sign-in email once the inbox is open.
CYBEROUTER_TIMEOUT=180000

# Max ms to wait for the Cloudflare Turnstile challenge to complete.
CYBEROUTER_TURNSTILE_TIMEOUT=150000

# Retries per account on transient failures (mail delay, Turnstile, network).
# Rate-limit errors abort immediately (retrying will not help).
CYBEROUTER_RETRIES=3

# Number of accounts and parallelism.
CYBEROUTER_COUNT=1
CYBEROUTER_CONCURRENCY=1

# Optional fixed API-key name. Leave empty for a random one.
CYBEROUTER_KEY_NAME=

# Pattern for random key names. Tokens: {adj} {noun} {num}.
CYBEROUTER_KEY_NAME_PATTERN={adj}-{noun}-{num}

# Set to 1 to run the browser visibly (debugging).
CYBEROUTER_HEADFUL=0

# Set to 1 to leave the browser open after the run (debugging).
CYBEROUTER_KEEP_BROWSER=0

# ---- Proxy ----------------------------------------------------------------
# Route the browser (and therefore all form traffic) through a proxy.
# Format: http://user:pass@host:port  or  socks5://host:port
# Leave empty for a direct connection.
#
# Cloudflare protects both zenvex.dev and Cyberouter. Public "free" proxy lists
# almost never pass Turnstile; use a paid residential proxy or a clean IP.
CYBEROUTER_PROXY=

# Alternative: CYBEROUTER_PROXY is also read from PROXY_URL / HTTPS_PROXY.
